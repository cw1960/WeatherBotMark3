# Copy to bot/.env and fill in. bot/.env is git-ignored — NEVER commit real values.

# --- Supabase (use the service_role key: the bot bypasses RLS) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Polymarket (only needed for LIVE trading; simulation runs without it) ---
# The SDK derives CLOB API credentials from the private key automatically.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=

# --- Jev (TypeSafe System One) — official SDK reads these names ---
TYPESAFE_API_KEY=
# Pinned so Jev's behaviour doesn't change under us; bump deliberately.
TYPESAFE_DEFAULT_MODEL=jev-1.13.0

# --- Open-Meteo (multi-model forecasts). Free endpoint is NON-commercial only;
#     set a paid key before live trading and requests switch to customer-api.open-meteo.com ---
OPEN_METEO_API_KEY=

# --- Weather sources (public APIs ask for a contact User-Agent) ---
NWS_USER_AGENT=WeatherBotMark3 (you@example.com)

# --- Runtime ---
LOG_LEVEL=INFO
