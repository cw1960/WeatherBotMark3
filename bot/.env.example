# Copy to bot/.env and fill in. bot/.env is git-ignored — NEVER commit real values.

# --- Supabase (use the service_role key: the bot bypasses RLS) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Polymarket (Polygon wallet + CLOB API creds) ---
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_CHAIN_ID=137

# --- Jev System One ---
JEV_API_URL=https://api.jev.ai/v1
JEV_API_KEY=
JEV_MODEL=system-one

# --- Weather sources ---
NWS_USER_AGENT=WeatherBotMark3 (you@example.com)   # api.weather.gov requires a contact UA
MADIS_API_TOKEN=                                   # optional, for MADIS/Synoptic METAR feed

# --- Runtime ---
LOG_LEVEL=INFO
